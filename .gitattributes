* text=auto eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.png binary
*.ico binary
*.dll binary
*.lib binary
# Preserve the fixed upstream license's trailing blank lines byte-for-byte.
third-party/gcc-15.2.0/COPYING.RUNTIME whitespace=-blank-at-eof
# Keep vendored license and shader text snapshots without whitespace-only edits.
vendor/egui-directx11/LICENSE-* whitespace=-blank-at-eof
vendor/egui-directx11/shaders/*.hlsl whitespace=-blank-at-eof
# Unified-diff context preserves upstream whitespace.
third-party/patches/zvbi-no-program-id.patch whitespace=-trailing-space,-space-before-tab
# Preserve the published wasapi source bytes and license inventory hashes.
vendor/wasapi/** -text whitespace=cr-at-eol
vendor/wasapi/README.md whitespace=cr-at-eol,-trailing-space
# Preserve unified-diff context required by the pinned native patch.
scripts/ffmpeg-preroll/metadata-preroll.patch whitespace=-trailing-space,-space-before-tab
# Preserve upstream rustfmt-skipped test vectors and their audited source hash.
vendor/image-webp/src/yuv.rs whitespace=-blank-at-eol
