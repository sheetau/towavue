LANGUAGE 0, 0
1 ICON "assets/towavue.ico"

1 VERSIONINFO
FILEVERSION @VERSION_COMPONENTS@
PRODUCTVERSION @VERSION_COMPONENTS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "sheeta\0"
            VALUE "FileDescription", "towavue media viewer\0"
            VALUE "FileVersion", "@VERSION@\0"
            VALUE "InternalName", "towavue\0"
            VALUE "OriginalFilename", "towavue.exe\0"
            VALUE "ProductName", "towavue\0"
            VALUE "ProductVersion", "@VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
