--- /dev/null
+++ b/libavcodec/towavue_preroll.c
@@ -0,0 +1,101 @@
+/* Private preroll policy shared across frame workers through packet opaque_ref.
+ * Stop and admission share one atomic word: once stop returns zero outstanding
+ * frames, no worker can subsequently admit an omitted frame for this policy.
+ * Dropped outputs conservatively remain outstanding and force ordinary retry.
+ * Reference counting owns the policy; no caller or codec context is borrowed. */
+#include <stdatomic.h>
+#include "config_components.h"
+#include "avcodec.h"
+#include "libavutil/mem.h"
+#include "towavue_preroll.h"
+
+typedef struct TowavuePrerollPolicy {
+    int64_t threshold;
+    atomic_uint_fast64_t state;
+} TowavuePrerollPolicy;
+
+static char policy_owner;
+
+uint32_t avcodec_towavue_preroll_v1_codecs(void)
+{
+    uint32_t mask = 0;
+#if CONFIG_HEVC_D3D11VA2_HWACCEL
+    mask |= 1;
+#endif
+#if CONFIG_AV1_D3D11VA2_HWACCEL
+    mask |= 4;
+#endif
+    return mask;
+}
+
+static void free_policy(void *opaque, uint8_t *data)
+{
+    av_free(data);
+}
+
+static TowavuePrerollPolicy *policy_from_ref(const AVBufferRef *ref)
+{
+    if (!ref || ref->size != sizeof(TowavuePrerollPolicy) ||
+        av_buffer_get_opaque(ref) != &policy_owner)
+        return NULL;
+    return (TowavuePrerollPolicy *)ref->data;
+}
+
+AVBufferRef *avcodec_towavue_preroll_v1_alloc(int64_t threshold)
+{
+    TowavuePrerollPolicy *policy;
+    AVBufferRef *ref;
+    if (threshold <= 0)
+        return NULL;
+    policy = av_mallocz(sizeof(*policy));
+    if (!policy)
+        return NULL;
+    policy->threshold = threshold;
+    atomic_init(&policy->state, 0);
+    ref = av_buffer_create((uint8_t *)policy, sizeof(*policy), free_policy,
+                           &policy_owner, 0);
+    if (!ref)
+        av_free(policy);
+    return ref;
+}
+
+int64_t avcodec_towavue_preroll_v1_stop(AVBufferRef *ref)
+{
+    TowavuePrerollPolicy *policy = policy_from_ref(ref);
+    if (!policy)
+        return AVERROR(EINVAL);
+    return atomic_fetch_or(&policy->state, 1) >> 1;
+}
+
+int ff_towavue_preroll_try_omit(const AVFrame *frame)
+{
+    TowavuePrerollPolicy *policy = policy_from_ref(frame->opaque_ref);
+    uint_fast64_t state;
+    if (!policy || frame->pts == AV_NOPTS_VALUE || frame->pts >= policy->threshold)
+        return 0;
+    state = atomic_load(&policy->state);
+    for (;;) {
+        if ((state & 1) || state >= INT64_MAX - 2)
+            return 0;
+        if (atomic_compare_exchange_weak(&policy->state, &state, state + 2))
+            return 1;
+    }
+}
+
+int avcodec_towavue_preroll_v1_ack(const AVFrame *frame)
+{
+    TowavuePrerollPolicy *policy;
+    uint_fast64_t state;
+    if (!(frame->flags & AV_FRAME_FLAG_TOWAVUE_PREROLL_OMITTED))
+        return 0;
+    policy = policy_from_ref(frame->opaque_ref);
+    if (!policy)
+        return AVERROR(EINVAL);
+    state = atomic_load(&policy->state);
+    for (;;) {
+        if (state < 2)
+            return AVERROR(EINVAL);
+        if (atomic_compare_exchange_weak(&policy->state, &state, state - 2))
+            return 0;
+    }
+}
